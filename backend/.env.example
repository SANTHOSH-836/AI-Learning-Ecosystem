# SQLite by default — zero setup. Swap for Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/edunexus
DATABASE_URL=sqlite:///./edunexus.db

# Generate a real secret for anything beyond local demo use, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
